{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site }}{{- end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
{{- $pages = $pctx.RegularPages -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" 
     xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd"
     xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    {{- /* Műsor-adatok a [params.podcast] alól; ha hiányzik, a site adatai */}}
    {{- $p := .Site.Params.podcast | default dict }}
    {{- $desc := $p.description | default .Site.Params.description }}
    <title>{{ $p.title | default (printf "%s - Podcast" .Site.Title) }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ $desc }}</description>
    <language>hu</language>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{- with $p.author }}
    <itunes:author>{{ . }}</itunes:author>
    {{- end }}
    <itunes:summary>{{ $desc }}</itunes:summary>
    {{- if or $p.author $p.email }}
    <itunes:owner>
      {{- with $p.author }}
      <itunes:name>{{ . }}</itunes:name>
      {{- end }}
      {{- with $p.email }}
      <itunes:email>{{ . }}</itunes:email>
      {{- end }}
    </itunes:owner>
    {{- end }}
    {{- with $p.image }}
    <itunes:image href="{{ . | absURL }}"/>
    {{- end }}
    {{- range $p.categories }}
    {{- if .sub }}
    <itunes:category text="{{ .text }}">
      <itunes:category text="{{ .sub }}"/>
    </itunes:category>
    {{- else }}
    <itunes:category text="{{ .text }}"/>
    {{- end }}
    {{- end }}
    <itunes:explicit>{{ if $p.explicit }}true{{ else }}false{{ end }}</itunes:explicit>
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ with .Params.description }}{{ . }}{{ end }}</description>
      {{- with .Params.audioFile }}
      {{- /* Same path logic as podcast-player.html: bare filename → /audio/ */}}
      {{- $src := . }}
      {{- if not (or (strings.HasPrefix $src "/") (strings.HasPrefix $src "http")) }}
        {{- $src = printf "/audio/%s" $src }}
      {{- end }}
      {{- $length := 0 }}
      {{- $local := printf "static%s" $src }}
      {{- if and (not (strings.HasPrefix $src "http")) (fileExists $local) }}
        {{- $length = (os.Stat $local).Size }}
      {{- end }}
      <enclosure url="{{ $src | absURL }}" length="{{ $length }}" type="audio/mpeg"/>
      {{- end }}
      {{- with .Params.duration }}
      <itunes:duration>{{ . }}</itunes:duration>
      {{- end }}
      {{- /* Epizódkép; ha nincs, az appok a műsor borítóját mutatják */}}
      {{- with .Params.image }}
      {{- $img := . }}
      {{- if not (or (strings.HasPrefix $img "/") (strings.HasPrefix $img "http")) }}
        {{- $img = printf "/images/%s" $img }}
      {{- end }}
      <itunes:image href="{{ $img | absURL }}"/>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
